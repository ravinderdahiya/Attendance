# Copy to `.env` at the repo root on the VPS (next to docker-compose.yml).
# Read both by docker-compose (for interpolation) and by the backend
# container (via env_file) as its Laravel .env.

# --- docker-compose interpolation ---
POSTGRES_USER=mharidhani
POSTGRES_PASSWORD=
POSTGRES_DB=mharidhani
VITE_API_BASE_URL=

# --- Laravel ---
APP_NAME="Mhari Dhani"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mharidhani.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mharidhani
DB_USERNAME=mharidhani
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
