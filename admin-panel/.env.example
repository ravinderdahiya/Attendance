# Local API (Laravel). In Docker production this is left empty = same-origin /api.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Local marketing site URL for header links on the login page.
VITE_SITE_URL=http://localhost:5182

# Local dev-only auto-login (LoginPage pre-fills + auto-submits with these).
# Leave blank to disable auto-login. Never put real production creds here.
VITE_DEV_USERNAME=manager
VITE_DEV_PASSWORD=Manager@123
