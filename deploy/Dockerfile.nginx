# Build context: repository root
FROM node:20-bookworm-slim AS website-build
WORKDIR /app
COPY website/package.json website/package-lock.json ./
RUN npm ci
COPY website/ ./
RUN npm run build

FROM node:20-bookworm-slim AS admin-build
WORKDIR /app
COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci
COPY admin-panel/ ./
# Served under /admin/ alongside the marketing site at the domain root.
ENV VITE_BASE_PATH=/admin/
# Empty = same-origin (nginx proxies /api). Override at build if needed.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=website-build /app/dist /usr/share/nginx/html
COPY --from=admin-build /app/dist /usr/share/nginx/html/admin
EXPOSE 80
